# Factline V2 Environment Variables

# Server
ENVIRONMENT=development
PORT=8000

# Database
DATABASE_URL=postgresql://factline_user:factline_password@localhost:5432/factline_db
SQLITE_PUBLIC_DB_PATH=./data/public_dashboard.sqlite

# Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Vector DB
QDRANT_URL=http://localhost:6333

# Models
LM_STUDIO_URL=http://localhost:1234/v1
MODEL_SMALL=meta-llama-3-8b-instruct
MODEL_MEDIUM=meta-llama-3-8b-instruct
MODEL_LARGE=meta-llama-3-8b-instruct

# URLs
PUBLIC_BASE_URL=https://reports.factline.xyz
